{
  "name": "@mizuikki/pi-workflow-orchestrator",
  "version": "2.14.0",
  "private": true,
  "description": "Pi Workflow Orchestrator: deterministic JavaScript workflows with subagents, persistence, resume, model controls, and Trellis integration.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "extensions/",
    "src/",
    "docs/architecture.md",
    "docs/storage.md",
    "README.md"
  ],
  "scripts": {
    "test": "npm run check && npm run build && npm run test:unit",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:pi-fork": "node scripts/test-pi-fork.mjs",
    "test:package-smoke": "bash scripts/test-package-smoke.sh",
    "test:local-install-smoke": "node scripts/test-local-install-smoke.mjs",
    "smoke:trellis-context": "node scripts/smoke-trellis-context.mjs",
    "verify:trellis-oracle": "node scripts/verify-trellis-1.0.4-oracle.mjs ../Trellis/packages/cli/src/templates/pi/extensions/trellis/index.ts.txt",
    "verify:product-boundary": "node scripts/verify-product-boundary.mjs",
    "check": "biome check .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "build": "node scripts/build.mjs",
    "benchmark:persistence": "tsx scripts/benchmark-run-persistence.ts",
    "dev": "tsx src/index.ts"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "workflow",
    "workflows",
    "workflow-orchestrator",
    "orchestration",
    "subagents",
    "multi-agent",
    "agents",
    "ai-agents",
    "parallel",
    "fan-out",
    "claude-code",
    "llm"
  ],
  "pi": {
    "extensions": [
      "extensions/workflow.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuintinShaw/pi-dynamic-workflows.git"
  },
  "author": "QuintinShaw",
  "contributors": [
    {
      "name": "michaelliv",
      "url": "original author"
    }
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "acorn": "^8.16.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@biomejs/biome": "2.4.16",
    "@earendil-works/pi-ai": "file:../pi/packages/ai",
    "@earendil-works/pi-coding-agent": "file:../pi/packages/coding-agent",
    "@earendil-works/pi-tui": "file:../pi/packages/tui",
    "fast-check": "^4.8.0",
    "tsx": "latest",
    "typebox": "1.3.7",
    "typescript": "latest"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "bugs": {
    "url": "https://github.com/QuintinShaw/pi-dynamic-workflows/issues"
  },
  "homepage": "https://github.com/QuintinShaw/pi-dynamic-workflows#readme"
}
